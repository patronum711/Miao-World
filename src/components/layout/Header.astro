---
import { navigation } from "../../data/navigation";
import { href } from "../../utils/path";

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 right-0 left-0 z-50 border-b border-border/60 bg-bg/80 backdrop-blur">
  <nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
    <a
      href={href("/")}
      class="text-base font-semibold tracking-tight text-text-primary transition-colors hover:text-accent"
    >
      Miao&rsquo;s World
    </a>
    <div class="flex items-center gap-1">
      <ul class="flex items-center gap-1">
        {
          navigation.map((item) => {
            const isActive =
              item.path === "/"
                ? currentPath === "/"
                : currentPath.startsWith(item.path);
            return (
              <li>
                <a
                  href={href(item.path)}
                  class={`link-underline rounded px-3 py-1.5 text-sm transition-colors ${
                    isActive
                      ? "text-accent"
                      : "text-text-secondary hover:text-text-primary"
                  }`}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
      <a
        href={href("/search")}
        class={`rounded p-1.5 transition-colors ${
          currentPath === "/search"
            ? "text-accent"
            : "text-text-secondary hover:text-text-primary"
        }`}
        aria-label="搜索"
        title="搜索"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.35-4.35" />
        </svg>
      </a>
      <button
        class="theme-toggle ml-0.5"
        id="theme-toggle"
        aria-label="切换主题"
        title="切换主题: 系统 / 暗色 / 亮色"
      >
        <!-- Sun icon (shown in dark mode → indicates "click for light") -->
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
        </svg>
        <!-- Moon icon (shown in light mode → indicates "click for dark") -->
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <!-- System icon (shown in system mode) -->
        <svg class="icon-system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
          <path d="M8 21h8M12 17v4"/>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    const order = ["system", "dark", "light"];
    btn.addEventListener("click", () => {
      const current = localStorage.getItem("theme") || "system";
      const next = order[(order.indexOf(current) + 1) % order.length];
      localStorage.setItem("theme", next);
      if (next === "system") {
        document.documentElement.removeAttribute("data-theme");
      } else {
        document.documentElement.setAttribute("data-theme", next);
      }
    });
  })();
</script>

<!-- Spacer to offset fixed header -->
<div class="h-[61px]" />
