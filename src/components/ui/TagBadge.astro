---
interface Props {
  tag: string;
  href?: string;
}
const { tag, href } = Astro.props;

const classes =
  "inline-block rounded-full border border-border px-2.5 py-0.5 text-xs text-text-secondary transition-colors hover:border-accent/40 hover:text-accent";
---

{href ? <a {href} class={classes}>{tag}</a> : <span class={classes}>{tag}</span>}
