---
import type { CollectionEntry } from "astro:content";
import { href } from "../../utils/path";

interface Props {
  prev: CollectionEntry<"blog"> | null;
  next: CollectionEntry<"blog"> | null;
}
const { prev, next } = Astro.props;
if (!prev && !next) return;
---

<nav class="mt-16 border-t border-border/40 pt-8">
  <div class="flex justify-between gap-4">
    {
      prev ? (
        <a
          href={href(`/blog/${prev.id.replace(/\.mdx?$/, "")}`)}
          class="group flex flex-1 flex-col"
        >
          <span class="mb-1 text-xs text-text-secondary">上一篇</span>
          <span class="text-sm font-medium text-text-primary transition-colors group-hover:text-accent">
            {prev.data.title}
          </span>
        </a>
      ) : (
        <div />
      )
    }
    {
      next ? (
        <a
          href={href(`/blog/${next.id.replace(/\.mdx?$/, "")}`)}
          class="group flex flex-1 flex-col items-end text-right"
        >
          <span class="mb-1 text-xs text-text-secondary">下一篇</span>
          <span class="text-sm font-medium text-text-primary transition-colors group-hover:text-accent">
            {next.data.title}
          </span>
        </a>
      ) : (
        <div />
      )
    }
  </div>
</nav>
