---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../../utils/date";
import TagBadge from "../ui/TagBadge.astro";

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const { title, description, publishedAt, tags } = post.data;
---

<article class="group border-b border-border/40 py-8 last:border-b-0">
  <a href={`/blog/${post.id.replace(/\.mdx?$/, "")}`} class="block">
    <h2
      class="mb-2 text-lg font-semibold text-text-primary transition-colors group-hover:text-accent"
    >
      {title}
    </h2>
  </a>
  <div class="mb-3 flex items-center gap-3 text-sm text-text-secondary">
    <time datetime={publishedAt.toISOString()}>
      {formatDate(publishedAt)}
    </time>
  </div>
  <p class="mb-4 leading-relaxed text-text-secondary">{description}</p>
  {
    tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => <TagBadge tag={tag} />)}
      </div>
    )
  }
</article>
