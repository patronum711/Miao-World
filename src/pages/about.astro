---
import BaseLayout from "../components/layout/BaseLayout.astro";

const skills = [
  "TypeScript",
  "React",
  "Vue",
  "Node.js",
  "Python",
  "Tailwind CSS",
  "Git",
  "Linux",
];

const contact = [
  { label: "GitHub", href: "https://github.com/patronum711", icon: "github" },
  { label: "Email", href: "mailto:patronum711@example.com", icon: "email" },
];
---

<BaseLayout
  title="关于"
  description="关于 Miao — 计算机专业学生，热爱技术与探索。"
>
  <!-- Hero -->
  <section class="animate-enter mt-20 mb-14">
    <div class="flex items-start gap-6">
      <!-- Avatar -->
      <div
        class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-accent/10 text-xl font-semibold text-accent"
        aria-hidden="true"
      >
        M
      </div>
      <div>
        <h1 class="mb-3 text-2xl font-semibold tracking-tight">
          Miao
        </h1>
        <p class="max-w-lg text-sm leading-relaxed text-text-secondary">
          大三计算机在读，喜欢写代码和折腾技术。对前端工程化、用户体验设计有浓厚兴趣。业余时间热爱旅行，
          用镜头和文字记录走过的路。
        </p>
      </div>
    </div>
  </section>

  <!-- Cards -->
  <div class="animate-enter stagger-1 flex flex-col gap-6">

    <!-- Skills -->
    <section class="rounded-xl border border-border/60 p-6">
      <h2 class="mb-4 text-sm font-medium uppercase tracking-wider text-text-secondary">
        技能
      </h2>
      <div class="flex flex-wrap gap-2">
        {skills.map((s) => (
          <span class="rounded-full border border-border/60 px-3 py-1.5 text-xs text-text-secondary transition-colors hover:border-accent/30 hover:text-accent">
            {s}
          </span>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section class="rounded-xl border border-border/60 p-6">
      <h2 class="mb-4 text-sm font-medium uppercase tracking-wider text-text-secondary">
        教育
      </h2>
      <div class="flex items-baseline justify-between gap-4">
        <div>
          <p class="text-sm font-medium text-text-primary">计算机科学与技术</p>
          <p class="mt-1 text-xs text-text-secondary">本科在读 · 大三</p>
        </div>
        <span class="shrink-0 text-xs text-text-secondary/60">2023 – 2027</span>
      </div>
    </section>

    <!-- Contact -->
    <section class="rounded-xl border border-border/60 p-6">
      <h2 class="mb-4 text-sm font-medium uppercase tracking-wider text-text-secondary">
        联系
      </h2>
      <div class="flex flex-wrap gap-6">
        {
          contact.map((c) => (
            <a
              href={c.href}
              class="inline-flex items-center gap-2 text-sm text-text-secondary transition-colors hover:text-accent"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="text-accent/60 text-xs">{">"}</span>
              {c.label}
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
