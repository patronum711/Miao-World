---
import { href } from "../utils/path";
import BaseLayout from "../components/layout/BaseLayout.astro";

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title="搜索"
  description="搜索站内文章与内容。"
>
  <div class="reveal mt-20 mb-12">
    <h1 class="mb-2 text-2xl font-semibold tracking-tight">搜索</h1>
    <p class="text-sm text-text-secondary">搜索站内全部内容</p>

    <div class="mt-8">
      <div class="relative">
        <svg
          class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-text-secondary"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.35-4.35" />
        </svg>
        <input
          id="search-input"
          type="text"
          autocomplete="off"
          placeholder="输入关键词开始搜索..."
          class="w-full rounded-lg border border-border/60 bg-bg py-3 pr-4 pl-10 text-sm text-text-primary placeholder:text-text-secondary/60 outline-none transition-all focus:border-accent/50 focus:ring-1 focus:ring-accent/20"
        />
      </div>
    </div>
  </div>

  <div id="search-results" class="reveal stagger-1">
    <!-- Empty initial state -->
    <p id="search-empty" class="text-center text-sm text-text-secondary">
      输入关键词，搜索站内文章与内容
    </p>
  </div>

  <template id="result-template">
    <a class="search-result group block rounded-lg border border-border/40 p-5 transition-all hover:border-accent/30">
      <h3 class="mb-1 text-sm font-medium text-text-primary transition-colors group-hover:text-accent"></h3>
      <p class="mb-2 break-all text-xs text-text-secondary"></p>
      <p class="result-excerpt text-sm leading-relaxed text-text-secondary"></p>
    </a>
  </template>
</BaseLayout>

<script>
  import { href } from "../utils/path";

  const input = document.getElementById("search-input") as HTMLInputElement;
  const results = document.getElementById("search-results")!;
  const emptyHint = document.getElementById("search-empty")!;
  const template = document.getElementById("result-template") as HTMLTemplateElement;
  const baseUrl = import.meta.env.BASE_URL;

  let pagefind: any = null;
  let debounceTimer: ReturnType<typeof setTimeout>;

  async function loadPagefind() {
    if (pagefind) return pagefind;
    // Check if search index exists (only available after pnpm build)
    const indexPath = `${baseUrl}/pagefind/pagefind-entry.json`;
    const res = await fetch(indexPath, { method: "HEAD" });
    if (!res.ok) {
      results.innerHTML =
        '<p class="text-center text-sm text-text-secondary">搜索仅在构建后可用。请运行 <code>pnpm build && pnpm preview</code> 后测试。</p>';
      throw new Error("Search index not found");
    }
    try {
      const pfUrl = baseUrl + "/pagefind/pagefind.js";
      const text = await fetch(pfUrl).then((r) => r.text());
      const blob = new Blob([text], { type: "text/javascript" });
      const blobUrl = URL.createObjectURL(blob);
      const pf = await import(blobUrl);
      URL.revokeObjectURL(blobUrl);
      pagefind = pf.createInstance({ basePath: baseUrl + "/pagefind/" });
      await pagefind.init();
      return pagefind;
    } catch (err) {
      console.error("Pagefind 加载失败:", err);
      results.innerHTML =
        '<p class="text-center text-sm text-text-secondary">搜索加载失败，请稍后重试</p>';
      throw err;
    }
  }

  input.addEventListener("input", () => {
    clearTimeout(debounceTimer);
    const query = input.value.trim();

    if (!query) {
      results.innerHTML = "";
      results.appendChild(emptyHint);
      emptyHint.classList.remove("hidden");
      return;
    }

    debounceTimer = setTimeout(async () => {
      try {
        const pf = await loadPagefind();
        const search = await pf.search(query);
        if (!search || search.results.length === 0) {
          results.innerHTML =
            '<p class="text-center text-sm text-text-secondary">未找到相关内容</p>';
          return;
        }

        const data = await Promise.all(
          search.results.slice(0, 10).map((r: any) => r.data()),
        );

        results.innerHTML = "";
        const list = document.createElement("div");
        list.className = "flex flex-col gap-3";

        data.forEach((item: any) => {
          const card = template.content.cloneNode(true) as DocumentFragment;
          const link = card.querySelector("a")!;
          const title = card.querySelector("h3")!;
          const urlEl = card.querySelector("p")!;
          const excerpt = card.querySelector(".result-excerpt")!;

          const cleanUrl = item.url.replace(/\/index\.html$/, "/").replace(/\.html$/, "/");
          link.href = cleanUrl;
          title.textContent = item.meta?.title || item.url;
          urlEl.textContent = cleanUrl;
          excerpt.innerHTML = item.excerpt || "";

          list.appendChild(card);
        });

        results.appendChild(list);
      } catch {
        results.innerHTML =
          '<p class="text-center text-sm text-text-secondary">搜索失败，请稍后重试</p>';
      }
    }, 200);
  });

  // Initialize
  (() => {
    results.innerHTML = "";
    results.appendChild(emptyHint);
  })();
</script>
