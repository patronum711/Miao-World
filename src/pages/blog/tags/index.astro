---
import { getCollection } from "astro:content";
import { href } from "../../../utils/path";
import BaseLayout from "../../../components/layout/BaseLayout.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);

const tagMap = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagMap.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout
  title="标签"
  description="按标签浏览文章"
>
  <h1 class="reveal mb-2 mt-12 text-2xl font-semibold tracking-tight">
    标签
  </h1>
  <p class="reveal mb-10 text-sm text-text-secondary">
    共 {tags.length} 个标签，{posts.length} 篇文章
  </p>

  <div class="reveal flex flex-wrap gap-3">
    {
      tags.map(([tag, count]) => (
        <a
          href={href(`/blog/tags/${tag}`)}
          class="card-hover inline-flex items-center gap-2 rounded-lg border border-border/60 px-4 py-2.5 text-sm hover:text-accent"
        >
          <span>{tag}</span>
          <span class="rounded-full bg-bg-warm px-1.5 py-0.5 text-xs tabular-nums text-text-secondary">
            {count}
          </span>
        </a>
      ))
    }
  </div>
</BaseLayout>
