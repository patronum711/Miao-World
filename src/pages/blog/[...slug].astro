---
import { render, getCollection } from "astro:content";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import PostContent from "../../components/blog/PostContent.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return Promise.all(
    posts.map(async (post) => {
      const { headings } = await render(post);
      return {
        params: { slug: post.id.replace(/\.mdx?$/, "") },
        props: { post, headings },
      };
    }),
  );
}

interface Props {
  post: Awaited<ReturnType<typeof getCollection<"blog">>>[number];
  headings: Awaited<ReturnType<typeof render>>["headings"];
}
const { post, headings } = Astro.props;

/* Prev / next */
const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const idx = allPosts.findIndex((p) => p.id === post.id);
const prev = idx > 0 ? allPosts[idx - 1] : null;
const next = idx < allPosts.length - 1 ? allPosts[idx + 1] : null;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.cover}
>
  <PostContent
    post={post}
    headings={headings}
    prev={prev}
    next={next}
  />
</BaseLayout>
